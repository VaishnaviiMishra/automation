# Copy to ".env" in the repo root. Do not commit real secrets.

# Required for STG store 23005 (name matches test-data/datasets/stg/usa/23005/config.json)
STG_SHOWCASE_API_KEY=

# Optional override of the base URL in config.json
# STG_SERVICE_BASE_URL=https://services.stg.ezcorp.com

# Microsoft Teams — Power Automate / Workflows webhook URL
# Used only by: npm run test:teams:stg:usa:23005 (sets TEAMS_NOTIFY=1)
TEAMS_WEBHOOK_URL=

# Set to 1 to log Teams reporter debug lines
TEAMS_DEBUG=0
